import { useState } from 'react'
import './App.css'

function App() {
  const [task,setTask] = useState([])
const [newtask,setnewTask]=useState("")

const addTask=()=>{
if(newtask.trim()=="")return;
setTask([...task,newtask]);
alert(`task added:"${newtask}"`);
setnewTask("");
};

const delTask=(index)=>{
setTask(task.filter((_,i)=>i!==index));
alert(`Task deleted:${task}`);
};

return (
   <div>
<h1>To-Do List</h1>
<input type='text' value={newtask} placeholder='enter a task' onChange={(e)=>setnewTask(e.target.value)}></input>

<button onClick={addTask}>Add  
</button>

<div>
  <ul>
  {task.map((task,index)=>(
    <li key={index} style={{margin:"8px 0px"}}>
      {task}<button onClick={()=>delTask(index)} style={{marginLeft:"10px",color:"red"}}>Delete</button>
    </li>
  ))}
  </ul>
</div>
   </div>
  )
}

export default App
